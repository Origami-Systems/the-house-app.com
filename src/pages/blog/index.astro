---
import { getCollection } from "astro:content";
import { Megaphone, Newspaper } from "@lucide/astro";
import { Badge, CardGrid, LargeTitleText } from "@origami-systems/ui";
import MainLayout from "~/layouts/MainLayout.astro";

const posts = (await getCollection("blog"))
    .filter(({ data }) => !data.draft)
    .sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());
---

<MainLayout title="Blog">
    <link
        slot="head"
        rel="alternate"
        type="application/rss+xml"
        title="The House App Blog RSS"
        href="https://the-house-app.com/blog/rss.xml"
    />
    <LargeTitleText>Blog</LargeTitleText>
    <CardGrid>
        {
            posts.map(({ data }) => (
                <article class="ignore-div">
                    <a href={`/blog/${data.slug}`} class="link">
                        <div class="item">
                            <div class="item-heading">
                                <span class="item-icon">
                                    {data.type === "announcement" ? (
                                        <Megaphone size={20} />
                                    ) : (
                                        <Newspaper size={20} />
                                    )}
                                </span>
                                <div class="title">{data.title}</div>
                            </div>
                            <div class="description">{data.description}</div>
                            <div class="extra">
                                <Badge>
                                    <span class="capitalize">{data.type}</span>
                                </Badge>
                                <div class="tags">
                                    {data.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}
                                </div>
                            </div>
                            <time datetime={data.timestamp.toISOString()}>
                                {data.timestamp.toLocaleDateString("en-US", {
                                    month: "short",
                                    day: "numeric",
                                    year: "numeric",
                                    timeZone: "UTC",
                                })}
                            </time>
                        </div>
                    </a>
                </article>
            ))
        }
    </CardGrid>
</MainLayout>

<style>
    .link {
        display: flex;
        flex: 1;
        color: var(--text-1);
        text-decoration: none;
    }
    .item {
        position: relative;
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 180px;
        border: var(--border);
        border-radius: var(--border-radius);
        background: var(--card-background);
        padding: 1.2rem;
        text-align: left;
        transition: var(--transitions);
    }
    .link:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
        border-radius: var(--border-radius);
    }
    .item-heading {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 0.75rem;
        padding-right: 5.5rem;
    }
    .item-icon {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 13px;
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 12%, transparent);
        font-style: normal;
    }
    .title {
        color: var(--text-0);
        font-size: 1.2rem;
        font-weight: 750;
        line-height: 1.25;
    }
    .description {
        color: var(--subtext-0);
        line-height: 1.5;
    }
    .extra {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        width: 100%;
        margin-top: auto;
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-left: auto;
        color: var(--subtext-0);
        font-size: 0.82rem;
    }
    time {
        position: absolute;
        top: 1rem;
        right: 1.1rem;
        color: var(--subtext-0);
        font-size: 0.78rem;
    }
    @media (max-width: 430px) {
        .item-heading {
            padding-right: 0;
        }
        time {
            position: static;
            order: 3;
        }
        .tags {
            display: none;
        }
    }
</style>
