---
import { Image } from "astro:assets";
import { AppSubmitButton } from "@origami-systems/ui/components";
import MainLayout from "~/layouts/MainLayout.astro";
import FeatureGrid from "~/components/index/FeatureGrid.astro";
import StandingsPreview from "~/components/index/StandingsPreview.astro";
import GettingStarted from "~/components/index/GettingStarted.astro";
import wordmarkDark from "@assets/icons/dark/wordmark.png";
import wordmarkLight from "@assets/icons/light/wordmark.png";
---

<MainLayout>
    <section class="hero">
        <div class="hero-copy">
            <div class="wordmark">
                <Image
                    src={wordmarkDark}
                    alt="The House App"
                    class="brand brand-dark"
                    loading="eager"
                    fetchpriority="high"
                />
                <Image
                    src={wordmarkLight}
                    alt="The House App"
                    class="brand brand-light"
                    loading="eager"
                    fetchpriority="high"
                />
            </div>
            <p class="eyebrow">Your whole house system, in one place</p>
            <h1>Give every point a purpose.</h1>
            <p class="hero-tagline">
                Building community through friendly competition.
            </p>
            <div class="actions">
                <a
                    href="https://app.the-house-app.com/example"
                    target="_blank"
                    rel="noopener noreferer"
                >
                    <AppSubmitButton primary>
                        Explore an Example
                    </AppSubmitButton>
                </a>
                <a href="/contact">
                    <AppSubmitButton> Talk to us </AppSubmitButton>
                </a>
            </div>
            <p class="login-note">
                Already use The House App? &nbsp;
                <a href="https://app.the-house-app.com">Log in</a>.
            </p>
        </div>

        <StandingsPreview />
    </section>

    <section class="section intro">
        <p class="kicker">Built for the way your community works</p>
        <h2>Keep the competition friendly and the progress visible.</h2>
        <p>
            Bring houses, points, events, and announcements together so students
            can see where they stand and staff can keep the momentum going. Set
            up the houses your way, then run the day-to-day from one shared
            home.
        </p>
    </section>

    <FeatureGrid />

    <GettingStarted />

    <section class="cta">
        <div>
            <p class="kicker">See it in action</p><h2>
                Take a look around before you decide.
            </h2><p>
                Open the example organization to explore the experience for
                yourself, or get in touch to talk about your organization.
            </p>
        </div>
        <div class="actions">
            <a
                href="https://app.the-house-app.com/example"
                target="_blank"
                rel="noopener noreferer"
            >
                <AppSubmitButton primary> Explore an Example</AppSubmitButton>
            </a>
            <a href="/contact">
                <AppSubmitButton> Contact us </AppSubmitButton>
            </a>
        </div>
    </section>

    <style>
        :global(main) {
            width: min(1180px, 100%);
            display: flex;
            flex-direction: column;
            gap: 7rem;
            padding-top: clamp(2.5rem, 6vw, 5.5rem);
        }
        h1 {
            max-width: unset;
        }
        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(390px, 0.95fr);
            align-items: center;
            gap: clamp(3rem, 7vw, 7rem);
            min-height: 620px;
        }
        .hero-copy {
            padding-left: 20px;
        }
        .wordmark {
            width: min(250px, 70%);
            margin-bottom: 2.5rem;
            user-select: none;
        }
        .brand {
            width: 100%;
            height: auto;
            display: block;
        }
        .brand-dark {
            display: none;
        }
        :global(html.dark) .brand-light {
            display: none;
        }
        :global(html.dark) .brand-dark {
            display: block;
        }
        .eyebrow,
        .kicker {
            margin: 0 0 0.8rem;
            color: var(--accent);
            font-size: 0.82rem;
            font-weight: 750;
            letter-spacing: 0.11em;
            text-transform: uppercase;
        }
        h1 {
            margin: 0;
            font-size: clamp(3.4rem, 7vw, 6.2rem);
            letter-spacing: -0.075em;
            line-height: 0.92;
        }
        .hero-tagline {
            margin: 1.1rem 0 0;
            color: var(--text-1);
            font-size: clamp(1.2rem, 2vw, 1.5rem);
            font-weight: 700;
            line-height: 1.35;
        }
        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 2rem;
        }
        .login-note {
            margin: 1rem 0 0;
            color: var(--subtext-0);
            font-size: 0.94rem;
        }
        .login-note a {
            color: var(--accent);
            font-weight: 700;
        }
        .feature-icon {
            display: grid;
            place-items: center;
            color: var(--accent);
            background: color-mix(in srgb, var(--accent) 12%, transparent);
            font-style: normal;
        }
        .intro {
            text-align: center;
        }
        h2 {
            margin: 0;
            font-size: clamp(2.2rem, 5vw, 4.2rem);
            line-height: 1.05;
            letter-spacing: -0.055em;
        }
        .intro h2 {
            max-width: 850px;
            margin-inline: auto;
        }
        .intro > p:last-child {
            max-width: 720px;
            margin: 1.4rem auto 0;
            color: var(--subtext-0);
            font-size: 1.1rem;
            line-height: 1.7;
        }
        .cta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 3rem;
            border: var(--border);
            border-radius: calc(var(--border-radius) + 6px);
            padding: clamp(2rem, 5vw, 4rem);
            width: min(1000px, 100%);
        }
        .cta h2 {
            max-width: 700px;
            font-size: clamp(2rem, 4.5vw, 3.7rem);
        }
        .cta p:last-child {
            max-width: 680px;
            color: var(--subtext-0);
            line-height: 1.65;
        }
        .cta .actions {
            flex-direction: column;
            min-width: 190px;
            margin-top: 0;
        }

        @media (max-width: 850px) {
            #index {
                gap: 5rem;
            }
            .hero {
                grid-template-columns: 1fr;
                min-height: auto;
            }
            .hero-copy {
                text-align: center;
                padding-left: 0;
            }
            .wordmark,
            .hero-tagline {
                margin-inline: auto;
            }
            .hero .actions {
                justify-content: center;
            }
            .product-preview {
                width: min(520px, calc(100% - 14px));
                margin-inline: auto;
            }
            .cta {
                flex-direction: column;
                align-items: flex-start;
            }
            .cta .actions {
                flex-direction: row;
            }
        }
        @media (max-width: 650px) {
            #index {
                gap: 4.5rem;
                padding-top: 2.5rem;
            }
            h1 {
                font-size: clamp(3.2rem, 16vw, 4.8rem);
            }
            .feature-grid {
                grid-template-columns: 1fr;
            }
            .feature,
            .feature.wide {
                grid-column: auto;
                min-height: 250px;
                display: flex;
                align-items: stretch;
            }
            .cta .actions {
                width: 100%;
            }
            .cta .actions a {
                flex: 1;
            }
        }
        @media (max-width: 430px) {
            .actions,
            .cta .actions {
                flex-direction: column;
            }
            .actions a {
                width: 100%;
            }
        }
    </style>
</MainLayout>
