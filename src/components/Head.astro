---
import { Apps } from "@origami-systems/config";

// import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
    canonicalUrl: URL;
    type?: "website" | "article";
    publishedTime?: Date;
    image?: string;
    imageAlt?: string;
    noindex?: boolean;
}

const data = Apps.house;
const {
    title,
    description = data.description,
    canonicalUrl,
    type = "website",
    publishedTime,
    image = "/icons/512x512.png",
    imageAlt = `${data.title} logo`,
    noindex = false,
} = Astro.props;
const imageUrl = new URL(image, canonicalUrl).href;
const organization = {
    "@type": "Organization",
    "@id": "https://origamisystems.org/#organization",
    name: "Origami Systems",
    url: "https://origamisystems.org/",
    logo: "https://origamisystems.org/icons/512x512.png",
    sameAs: [
        "https://www.instagram.com/origamisystems",
        "https://www.facebook.com/origamisystemsllc",
        "https://www.linkedin.com/company/origami-systems",
        "https://x.com/_origamisystems",
    ],
};
const structuredData =
    type === "article"
        ? {
              "@context": "https://schema.org",
              "@type": "BlogPosting",
              headline: title.replace(/ \| The House App$/, ""),
              description,
              url: canonicalUrl.href,
              image: imageUrl,
              datePublished: publishedTime?.toISOString(),
              author: { "@id": organization["@id"] },
              publisher: organization,
              mainEntityOfPage: canonicalUrl.href,
          }
        : {
              "@context": "https://schema.org",
              "@graph": [
                  organization,
                  {
                      "@type": "WebSite",
                      name: data.title,
                      url: "https://the-house-app.com/",
                      publisher: { "@id": organization["@id"] },
                  },
              ],
          };
---

<title>{title}</title>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<meta charset="utf-8" />
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="publisher" content="Origami Systems" />
<meta name="keywords" content="The House App" />
<meta name="author" content="Origami Systems" />
<meta name="application-name" content={data.title} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content={data.title} />
<meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content="#f5fcff"
/>
<meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content="#000001"
/>
<meta
    name="background-color"
    media="(prefers-color-scheme: light)"
    content="#f5fcff"
/>
<meta
    name="background-color"
    media="(prefers-color-scheme: dark)"
    content="#000001"
/>
<meta property="og:title" content={title} />
<meta property="og:site_name" content={data.title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image" content={imageUrl} />
{publishedTime && (
    <meta
        property="article:published_time"
        content={publishedTime.toISOString()}
    />
)}
<meta name="twitter:card" content="summary" />
<meta name="twitter:site" content="@_origamisystems" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{noindex ? (
    <meta name="robots" content="noindex" />
) : (
    <link rel="canonical" href={canonicalUrl.href} />
)}

<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />

<link rel="manifest" href="/manifest.json" />
<link
    rel="icon"
    type="image/png"
    href="/icons/favicon-96x96.png"
    sizes="96x96"
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
    rel="preload"
    href="https://fonts.gstatic.com/s/dmsans/v17/rP2Hp2ywxg089UriCZOIHTWEBlw.woff2"
    as="font"
    type="font/woff2"
    crossorigin
/>
<link rel="sitemap" href="/sitemap-index.xml" />
<link
    rel="alternate"
    type="application/rss+xml"
    title="The House App Blog"
    href={new URL("/blog/rss.xml", canonicalUrl).href}
/>
<!-- <ClientRouter /> -->
<script is:inline>
    const theme = (() => {
        const localStorageTheme = localStorage?.getItem("color-mode") ?? "";
        if (["dark", "light"].includes(localStorageTheme)) {
            return localStorageTheme;
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return "dark";
        }
        return "light";
    })();

    if (theme === "light") {
        document.documentElement.classList.remove("dark");
    } else {
        document.documentElement.classList.add("dark");
    }

    window.localStorage.setItem("color-mode", theme);
</script>
