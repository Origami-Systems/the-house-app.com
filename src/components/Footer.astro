---
import { Image } from "astro:assets";
import IconLight from "@assets/icons/light/icon.png";
---

<footer class="footer">
    <div class="footer-inner">
        <div class="footer-main">
            <div class="brand">
                <Image
                    src={IconLight}
                    alt="The House App"
                    width="58"
                    height="58"
                    class="brand-icon"
                />
                <div>
                    <strong>Origami Systems</strong>
                    <p>
                        &copy; 2024-{new Date().getFullYear()} Origami Systems LLC.
                        All rights reserved.
                    </p>
                </div>
            </div>

            <nav class="footer-links" aria-label="Footer navigation">
                <div>
                    <p>Product</p>
                    <a href="/">Home</a>
                    <a href="/blog">Blog</a>
                    <a href="/docs">Docs</a>
                </div>
                <div>
                    <p>Support</p>
                    <a href="/faq">FAQ</a>
                    <a href="/bugs-tracker">Bugs</a>
                    <a href="/contact">Contact</a>
                    <a
                        href="https://status.origamisystems.org"
                        target="_blank"
                        rel="noopener noreferrer">Status</a
                    >
                </div>
                <div>
                    <p>Social</p>
                    <a
                        href="https://www.instagram.com/the_house_app"
                        target="_blank"
                        rel="noopener noreferrer">Instagram</a
                    >
                    <a
                        href="https://www.facebook.com/origamisystemsllc"
                        target="_blank"
                        rel="noopener noreferrer">Facebook</a
                    >
                    <a
                        href="https://www.linkedin.com/company/origami-systems"
                        target="_blank"
                        rel="noopener noreferrer">LinkedIn</a
                    >
                    <a
                        href="https://x.com/_origamisystems"
                        target="_blank"
                        rel="noopener noreferrer">X</a
                    >
                </div>
            </nav>
        </div>

        <div class="footer-bottom">
            <div>
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
            </div>
        </div>
    </div>
</footer>

<style>
    .footer {
        margin-top: 7rem;
        border-top: var(--divider-thin);
        transition: var(--transitions);
    }
    .footer-inner {
        width: min(1180px, 100%);
        margin-inline: auto;
        padding: 3rem 2rem 1.5rem;
    }
    .footer-main {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) auto;
        gap: clamp(3rem, 8vw, 8rem);
        align-items: start;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 1rem;
        max-width: 360px;
        text-align: left;
    }
    .brand-icon {
        flex-shrink: 0;
        border-radius: 0.7rem;
        user-select: none;
    }
    .brand strong {
        color: var(--text-0);
        font-size: 1.05rem;
    }
    .brand p {
        margin: 0.3rem 0 0;
        color: var(--subtext-0);
        line-height: 1.5;
    }
    .footer-links {
        display: grid;
        grid-template-columns: repeat(3, minmax(90px, 1fr));
        gap: clamp(2rem, 5vw, 4.5rem);
        text-align: left;
    }
    .footer-links p {
        margin: 0 0 0.7rem;
        color: var(--text-0);
        font-size: 0.9rem;
        font-weight: 800;
    }
    .footer-links a,
    .footer-bottom a {
        display: block;
        width: fit-content;
        margin: 0.45rem 0;
        color: var(--subtext-0);
        font-size: 0.9rem;
        text-decoration: none;
        transition: color var(--transition-time-short) ease;
    }
    .footer-links a:hover,
    .footer-bottom a:hover {
        color: var(--accent);
    }
    .footer-links a:focus-visible,
    .footer-bottom a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 2px;
    }
    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2.5rem;
        border-top: var(--divider-thin);
        padding-top: 1.25rem;
        color: var(--subtext-0);
        font-size: 0.82rem;
        text-align: left;
    }
    .footer-bottom > div {
        display: flex;
        gap: 1.2rem;
    }
    .footer-bottom a {
        margin: 0;
        font-size: inherit;
    }
    @media (max-width: 750px) {
        .footer-inner {
            padding-inline: 1rem;
        }
        .footer-main {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }
        .footer-links {
            width: 100%;
        }
    }
    @media (max-width: 480px) {
        .footer-links {
            grid-template-columns: repeat(2, 1fr);
            row-gap: 1.5rem;
        }
    }
</style>
