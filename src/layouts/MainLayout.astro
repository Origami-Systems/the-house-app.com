---
type Props = {
    title?: string;
    description?: string;
};

import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import LocalNotifications from "@/LocalNotifications.vue";
import TitleBar from "../components/navigation/TitleBar.astro";

import "../styles/global.css";
import "@origami-systems/ui/style.css";
import { Apps } from "@origami-systems/config";

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${Apps.house.title}` : Apps.house.title;
const canonicalUrl = new URL(
    Astro.url.pathname,
    Astro.site ?? Astro.url.origin,
);
---

<html lang="en" class="light">
    <head>
        <Head
            title={pageTitle}
            description={description}
            canonicalUrl={canonicalUrl}
        />

        <slot name="head" />
    </head>
    <body>
        <header id="title-bar-layout-header">
            <TitleBar />
        </header>
        <main id="title-bar-layout">
            <slot />
        </main>
        <Footer />
        <LocalNotifications client:only="vue" />
    </body>
</html>

<style is:global>
    #title-bar-layout {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        padding: 0 10px 10px 10px;
        transition:
            background-color var(--transition-time) ease,
            color var(--transition-time) ease,
            border-color var(--transition-time) ease;
    }

    #title-bar-layout-header {
        margin-bottom: 10px;
        transition:
            background-color var(--transition-time) ease,
            color var(--transition-time) ease,
            border-color var(--transition-time) ease;
    }
</style>
